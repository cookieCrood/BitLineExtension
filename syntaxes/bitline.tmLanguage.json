{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "BitLine",
    "scopeName": "source.bitline",

    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#variables"
        }
    ],

    "repository": {
        "comments": {
            "patterns": [
                {
                    "match": "//.*$",
                    "name": "comment.line.double-slash.bitline"
                }
            ]
        },

        "keywords": {
            "patterns": [
                {
                    "match": "\\b(BOX|IMPORT|IF|ELSE)\\b",
                    "name": "keyword.control.bitline"
                },
                {
                    "match": "\\b(NAND)\\b",
                    "name": "support.function.bitline"
                },
                {
                    "match": "\\b(bit|byte)\\b",
                    "name": "storage.type.bitline"
                },
                {
                    "match": "<<",
                    "name": "keyword.operator.bitline"
                },
                {
                    "match": "\\$",
                    "name": "keyword.control.bitline"
                },
                {
                    "match": "[:;,(){}]",
                    "name": "punctuation.separator.bitline"
                }
            ]
        },

        "strings": {
            "name": "string.quoted.double.bitline",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.bitline",
                    "match": "\\\\."
                }
            ]
        },

        "numbers": {
            "patterns": [
                {
                    "match": "\\[\\s*[01](?:\\s*[01]){7}\\s*\\]",
                    "name": "constant.numeric.byte.bitline"
                },
                {
                    "match": "\\b[01]\\b",
                    "name": "constant.numeric.binary.bitline"
                }
            ]
        },

        "functions": {
            "patterns": [
                {
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()",
                    "name": "entity.name.function.bitline"
                }
            ]
        },

        "variables": {
            "patterns": [
                {
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
                    "name": "variable.other.bitline"
                }
            ]
        }
    }
}